                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 27.000"
                                android:textColor="#555555"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Area detail: deskripsi + counter (default GONE) -->
                    <LinearLayout
                        android:id="@+id/layoutDetail5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDesc5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Matcha asli Jepang dipadukan dengan susu segar, rasa lembut dengan sedikit pahit yang seimbang."
                            android:textColor="#555555"
                            android:textSize="13sp" />

                        <!-- Counter di kanan bawah -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinus5"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="−"
                                android:textColor="#1A1A1A"
                                android:textSize="18sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#F8D3AE" />

                            <TextView
                                android:id="@+id/tvQty5"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlus5"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textColor="#1A1A1A"
                                android:textSize="18sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#F8D3AE" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Total pesanan (kanan bawah daftar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- TextView pertama mengambil sisa ruang dan rata kiri -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total pesanan: "
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <!-- TextView angka berada di sebelah kanan -->
        <TextView
            android:id="@+id/tvTotalOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu bawah: tombol Home dihapus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- enabled=false: baru aktif setelah minimal 1 makanan dipesan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrder"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Order"
            android:textAllCaps="false"
            android:textColor="#555555"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Profile"
            android:textAllCaps="false"
            android:textColor="#555555"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>