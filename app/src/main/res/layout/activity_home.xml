<?xml version="1.0" encoding="utf-8"?>
<!-- 5. Home -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".HomeActivity">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Pilih Menu"
        android:textColor="#1A1A1A"
        android:textSize="28sp"
        android:textStyle="bold" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- id dipakai sebagai root animasi (TransitionManager) -->
        <LinearLayout
            android:id="@+id/llFoodList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Kartu 1: Kopi Susu Gula Aren ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFood1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFF4EA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F8D3AE"
                app:strokeWidth="1dp">

                <!-- Wadah vertikal: baris utama + area detail (tersembunyi) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Baris utama: foto + nama + subjudul + harga -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            app:cardBackgroundColor="#F8D3AE"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/kopisusugulaaren" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kopi Susu Gula Aren"
                                android:textColor="#1A1A1A"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextLightCustom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Espresso, susu, gula aren"
                                android:textColor="#555555"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPrice1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 22.000"
                                android:textColor="#555555"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Area detail: deskripsi + counter (default GONE) -->
                    <LinearLayout
                        android:id="@+id/layoutDetail1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDesc1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Perpaduan espresso pilihan, susu segar, dan gula aren asli yang manis legit. Disajikan dingin dengan es batu."
                            android:textColor="#555555"
                            android:textSize="13sp" />

                        <!-- Counter di kanan bawah -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinus1"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="−"
                                android:textColor="#1A1A1A"
                                android:textSize="18sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#F8D3AE" />

                            <TextView
                                android:id="@+id/tvQty1"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#1A1A1A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlus1"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textColor="#1A1A1A"
                                android:textSize="18sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#F8D3AE" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

