                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="−"
                                android:textColor="#1A1A1A"
                                android:textSize="18sp"
                                app:cornerRadius="20dp"
                                app:strokeColor="#F8D3AE" />

                            <TextView
